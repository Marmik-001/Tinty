{
  "manifest_version": 3,
  "name": "Tinty — Tint your web, your way",
  "version": "0.7.0",
  "description": "Recolor the web using your favorite VS Code theme, custom wallpapers, or hybrid ambient backdrops.",
  "permissions": ["storage", "activeTab", "unlimitedStorage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tinty"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
